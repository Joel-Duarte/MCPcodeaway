# Generic OIDC + RFC 8693 Token Exchange Preset (Keycloak / Okta / Auth0 / Ping)

GATEWAY_APP_ENV=uat
GATEWAY_AUTH_MODE=oidc
GATEWAY_TOKEN_EXCHANGE_DIALECT=rfc8693
GATEWAY_GATEWAY_MODE=codemode
GATEWAY_READ_ONLY_PROD=true

GATEWAY_GATEWAY_PUBLIC_URL=https://mcp-gateway.company.internal
GATEWAY_OIDC_ISSUER=https://sso.company.internal/realms/enterprise
GATEWAY_OIDC_JWKS_URI=https://sso.company.internal/realms/enterprise/protocol/openid-connect/certs
GATEWAY_OIDC_AUDIENCE=api://mcp-code-gateway
GATEWAY_OIDC_TOKEN_ENDPOINT=https://sso.company.internal/realms/enterprise/protocol/openid-connect/token
GATEWAY_OIDC_CLIENT_ID=mcp-code-gateway
GATEWAY_OIDC_CLIENT_SECRET=<SET_IN_SECRET_MANAGER>
GATEWAY_ALLOWED_TENANTS='["enterprise"]'

# Optional custom claim mapping if your IdP nests roles or uses custom tenant claim names:
# GATEWAY_CLAIM_MAPPING='{"subject":"sub","tenant":"org_id","roles":"roles","groups":"groups","scopes":"scope","client_id":"azp"}'

{
  "realm": "mcp-readiness",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "gateway_admin" },
      { "name": "operator_viewer" },
      { "name": "finance_analyst" },
      { "name": "tool_approver" },
      { "name": "ops_engineer" }
    ]
  },
  "groups": [
    { "name": "finance" },
    { "name": "operations" },
    { "name": "operations-approvers" }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "Subject (sub)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "gateway.access",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "api://mcp-readiness",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "gateway-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "user.realm.role.mapping.roles": "",
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "gateway-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "groups",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "gateway-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "mcp.write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "mcp-readiness",
      "name": "MCPcodeaway local readiness client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/auth/admin/callback"],
      "webOrigins": ["http://localhost:8080"],
      "defaultClientScopes": ["basic", "gateway.access", "mcp.write"],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "readiness-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Readiness",
      "lastName": "Admin",
      "email": "readiness-admin@example.test",
      "credentials": [{ "type": "password", "value": "readiness-local-only", "temporary": false }],
      "realmRoles": ["gateway_admin"],
      "attributes": { "tenant": ["mcp-readiness"] }
    },
    {
      "username": "readiness-viewer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Readiness",
      "lastName": "Viewer",
      "email": "readiness-viewer@example.test",
      "credentials": [{ "type": "password", "value": "readiness-local-only", "temporary": false }],
      "realmRoles": ["operator_viewer"],
      "attributes": { "tenant": ["mcp-readiness"] }
    },
    {
      "username": "readiness-finance",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Readiness",
      "lastName": "Finance",
      "email": "readiness-finance@example.test",
      "credentials": [{ "type": "password", "value": "readiness-local-only", "temporary": false }],
      "realmRoles": ["finance_analyst", "tool_approver"],
      "groups": ["/finance"],
      "attributes": { "tenant": ["mcp-readiness"] }
    },
    {
      "username": "readiness-approver",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Readiness",
      "lastName": "Approver",
      "email": "readiness-approver@example.test",
      "credentials": [{ "type": "password", "value": "readiness-local-only", "temporary": false }],
      "realmRoles": ["tool_approver"],
      "groups": ["/operations-approvers"],
      "attributes": { "tenant": ["mcp-readiness"] }
    },
    {
      "username": "readiness-ops",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Readiness",
      "lastName": "Operations",
      "email": "readiness-ops@example.test",
      "credentials": [{ "type": "password", "value": "readiness-local-only", "temporary": false }],
      "realmRoles": ["ops_engineer", "ticketing_writer"],
      "groups": ["/operations"],
      "attributes": { "tenant": ["mcp-readiness"] }
    },
    {
      "username": "readiness-unassigned",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Readiness",
      "lastName": "Unassigned",
      "email": "readiness-unassigned@example.test",
      "credentials": [{ "type": "password", "value": "readiness-local-only", "temporary": false }],
      "attributes": { "tenant": ["mcp-readiness"] }
    },
    {
      "username": "readiness-other-tenant",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Readiness",
      "lastName": "Other Tenant",
      "email": "readiness-other-tenant@example.test",
      "credentials": [{ "type": "password", "value": "readiness-local-only", "temporary": false }],
      "realmRoles": ["finance_analyst"],
      "attributes": { "tenant": ["mcp-other"] }
    }
  ]
}

{
  "version": "1.0",
  "description": "Deterministic end-to-end Golden Dataset flows through MCPcodeaway gateway and mock enterprise upstreams.",
  "flows": [
    {
      "id": "rbac_deny_support_finance",
      "kind": "mcp_tools_list",
      "persona": "support_agent",
      "query": "mode=traditional",
      "expected_present_prefixes": ["ops_ticketing__"],
      "expected_absent_prefixes": [
        "snowflake_ledger__",
        "billing_legacy_eu__",
        "billing_legacy_us__"
      ]
    },
    {
      "id": "obo_rls_eu_vs_us_isolation",
      "kind": "obo_rls_matrix",
      "eu_persona": "eu_accountant",
      "us_persona": "us_accountant",
      "expected_eu_region": "EU",
      "expected_eu_customer": "CUST-1003",
      "expected_us_region": "US",
      "expected_us_customer": "CUST-1024"
    },
    {
      "id": "codemode_reconcile_overdue_grounded",
      "kind": "mcp_codemode_exec",
      "persona": "finance_analyst",
      "query": "mode=codemode&require_grounding=true",
      "code": "import asyncio\nledger, eu, us = await asyncio.gather(\n    snowflake_ledger__query_debt_ledger(status='overdue'),\n    billing_legacy_eu__list_eu_invoices(status='overdue'),\n    billing_legacy_us__list_us_invoices(status='overdue'),\n)\nbills = {i['customer_id']: i for i in (eu['invoices'] + us['invoices'])}\nmismatches = []\nfor row in ledger['rows']:\n    b = bills.get(row['customer_id'])\n    if b and round(row['ledger_balance'] - b['amount'], 2) != 0:\n        mismatches.append({'customer_id': row['customer_id'], 'delta': round(row['ledger_balance'] - b['amount'], 2)})\nsorted(mismatches, key=lambda m: m['customer_id'])",
      "expected_ok": true,
      "expected_grounded": true,
      "expected_customer_ids": ["CUST-1003", "CUST-1024"],
      "expect_compression": true
    },
    {
      "id": "grounding_blocks_hallucinated_id",
      "kind": "mcp_codemode_exec",
      "persona": "finance_analyst",
      "query": "mode=codemode&require_grounding=true",
      "code": "await snowflake_ledger__get_customer_balance(customer_id='CUST-1003')\n{'customer_id': 'CUST-9999', 'note': 'hallucinated'}",
      "expected_ok": false,
      "expected_error_type": "UnverifiedEntityError",
      "expected_error_substring": "CUST-9999"
    },
    {
      "id": "abac_post_filter_and_pii_redaction",
      "kind": "legacy_abac_and_pii",
      "persona": "eu_accountant",
      "expected_allowed_customer": "CUST-1003",
      "expected_blocked_customer": "CUST-1024",
      "expected_redacted_marker": "[REDACTED"
    },
    {
      "id": "auto_mode_algorithmic_routing",
      "kind": "mcp_auto_route",
      "persona": "finance_analyst",
      "query": "execution=auto",
      "headers": {
        "X-Intent": "reconcile all overdue invoices and summarize variance"
      },
      "expected_header_prefix": "auto->codemode",
      "expected_tool_present": "execute_code"
    },
    {
      "id": "admin_rbac_and_tenant_audit_isolation",
      "kind": "control_plane_rbac",
      "admin_persona": "gateway_admin",
      "non_admin_persona": "finance_analyst",
      "foreign_tenant": "tenant-other"
    },
    {
      "id": "profile_production_barebones_gate",
      "kind": "profile_gate",
      "profile": "production",
      "open_paths": ["/health", "/ready", "/metrics"],
      "blocked_gets": [
        "/dashboard",
        "/benchmarks/latest",
        "/dev/oidc/jwks"
      ]
    },
    {
      "id": "mcp_invalid_bearer_fails_closed",
      "kind": "mcp_invalid_auth",
      "expected_http_status": 401
    },
    {
      "id": "mcp_unsupported_protocol_version_rejected",
      "kind": "mcp_unsupported_protocol",
      "expected_http_status": 400,
      "expected_rpc_error_code": -32022
    },
    {
      "id": "mcp_missing_required_tool_argument_rejected",
      "kind": "mcp_invalid_arguments",
      "persona": "finance_analyst",
      "query": "mode=traditional",
      "tool_name": "snowflake_ledger__get_customer_balance",
      "expected_rpc_error_code": -32602
    }
  ],
  "business_value_flows": [
    {
      "id": "support_workflow_requires_all_lookups_and_ticket",
      "expected_required_tools": [
        "support_api__find_customer",
        "support_api__get_account",
        "support_api__get_order_history"
      ],
      "expected_completion_tool": "support_api__create_ticket",
      "expected_manual_baseline_minutes": 5,
      "expected_credited_completions": 1
    },
    {
      "id": "hr_fictional_user_update_verified_by_readback",
      "persona": "hr_ops",
      "employee_id": "EMP-01",
      "expected_name": "Avery Morgan",
      "expected_initial_role": "controller",
      "updated_role": "senior_controller",
      "expected_final_version": 2,
      "expected_required_tools": [
        "hr_directory__list_hr_employees",
        "hr_directory__get_hr_employee",
        "hr_directory__update_hr_employee"
      ],
      "expected_completion_tool": "hr_directory__get_hr_employee",
      "expected_manual_baseline_minutes": 8,
      "expected_credited_completions": 1
    },
    {
      "id": "support_workflow_ticket_without_order_lookup_is_incomplete",
      "missing_required_tool": "support_api__get_order_history",
      "expected_completion_recorded": false,
      "expected_credited_completions": 0
    },
    {
      "id": "support_workflow_code_mode_tracks_each_callback",
      "expected_callback_ordinals": [0, 1, 2, 3],
      "expected_credited_completions": 1
    },
    {
      "id": "standalone_value_rejects_second_logical_invocation",
      "expected_second_invocation_rpc_error": -32602,
      "expected_upstream_calls": 1
    }
  ],
  "recovery_flows": [
    {
      "id": "read_retries_once_then_succeeds",
      "kind": "read_retry_success",
      "failures_before_success": 1,
      "expected_calls": 2
    },
    {
      "id": "read_failure_stops_after_one_retry",
      "kind": "read_retry_exhausted",
      "failures_before_success": null,
      "expected_calls": 2,
      "expected_error_type": "upstream_unavailable",
      "expected_retry_attempts": 1
    },
    {
      "id": "write_commit_response_lost_is_not_replayed",
      "kind": "write_outcome_unknown",
      "expected_error_type": "upstream_unavailable",
      "expected_retry_attempts": 0,
      "expected_outcome_unknown": true,
      "expected_write_count": 1
    },
    {
      "id": "configured_circuit_blocks_then_recovers",
      "kind": "circuit_recovery",
      "failure_threshold": 2,
      "success_threshold": 2,
      "expected_error_type": "upstream_unhealthy"
    }
  ],
  "reconciliation_flows": [
    {
      "id": "write_response_lost_then_status_confirms_commit",
      "kind": "lost_response_status_readback",
      "expected_status": "committed",
      "expected_side_effect_count": 1
    },
    {
      "id": "same_idempotency_key_replays_one_effect",
      "kind": "idempotent_replay",
      "expected_replayed": true,
      "expected_side_effect_count": 1
    },
    {
      "id": "idempotency_key_payload_mismatch_rejected",
      "kind": "idempotency_conflict",
      "expected_http_status": 409,
      "expected_side_effect_count": 1
    }
  ],
  "task_recovery_flows": [
    {
      "id": "task_opt_in_recovers_commit_after_lost_response",
      "kind": "mcp_task_recovery",
      "expected_task_status": "completed",
      "expected_upstream_side_effect_count": 1
    },
    {
      "id": "legacy_client_gets_operation_status_fallback",
      "kind": "legacy_recovery_status",
      "expected_status_tool": "get_operation_status"
    },
    {
      "id": "same_key_different_payload_conflicts",
      "kind": "idempotency_conflict",
      "expected_rpc_error_code": -32602
    }
  ],
  "recovery_lab_flows": [
    {
      "id": "task_recovers_lost_response",
      "kind": "task_status_reconciliation",
      "expected_task_status": "completed",
      "expected_side_effect_count": 1
    },
    {
      "id": "same_key_replay_is_deduplicated",
      "kind": "idempotent_replay",
      "expected_side_effect_count": 1
    },
    {
      "id": "changed_payload_is_rejected",
      "kind": "idempotency_conflict",
      "expected_rpc_error_code": -32602,
      "expected_side_effect_count": 1
    },
    {
      "id": "legacy_client_uses_status_fallback",
      "kind": "legacy_status_fallback",
      "expected_side_effect_count": 2
    }
  ],
  "demo_traffic_flows": [
    {
      "id": "delayed_write_commits",
      "kind": "mock_delayed_write",
      "expected_status": "committed"
    },
    {
      "id": "idempotent_replay_has_one_effect",
      "kind": "mock_idempotent_replay",
      "expected_replayed": true
    },
    {
      "id": "changed_payload_key_conflicts",
      "kind": "mock_idempotency_conflict",
      "expected_rpc_error_code": -32602
    },
    {
      "id": "upstream_rejection_is_reported",
      "kind": "mock_upstream_rejection",
      "expected_rpc_error_code": -32602
    },
    {
      "id": "lost_response_can_be_checked",
      "kind": "mock_lost_response_status_readback",
      "expected_status": "committed"
    },
    {
      "id": "pending_upstream_stays_visible_for_reconciliation",
      "kind": "mock_upstream_pending_reconciliation",
      "expected_status": "processing"
    },
    {
      "id": "readonly_write_is_denied",
      "kind": "gateway_rbac_denial",
      "expected_ok": false
    },
    {
      "id": "demo_hr_profile_update_appears_in_business_value",
      "kind": "business_value_attributed_workflow",
      "workflow_id": "hr_directory/demo_fictional_employee_profile_update",
      "employee_id": "EMP-01",
      "expected_role": "senior_controller",
      "expected_manual_baseline_minutes": 8,
      "expected_completions": 1
    },
    {
      "id": "demo_hr_passive_detection_and_mcp_app_ui",
      "kind": "passive_workflow_and_ui",
      "workflow_id": "hr_directory/demo_fictional_employee_profile_update",
      "employee_id": "EMP-01",
      "expected_attribution_mode": "passive_matched",
      "expected_status": "completed_verified",
      "expected_mcp_app_resource_uri": "ui://mcpcodeaway/hr/employee-profile/r1"
    }
  ],
  "auto_workflow_detection_flows": [
    {
      "id": "workflow_x_hr_openapi_verified_readback",
      "upstream_name": "hr_directory",
      "upstream_kind": "fake_openapi_api",
      "mode": "traditional",
      "expected_status": "completed_verified",
      "expected_tier": "verified_readback",
      "expected_candidate_present": true,
      "manual_baseline_minutes": 8
    },
    {
      "id": "workflow_y_support_mcp_ticket_created",
      "upstream_name": "support_mcp",
      "upstream_kind": "fake_mcp_server",
      "mode": "traditional",
      "expected_status": "completed_unverified",
      "expected_candidate_present": true,
      "manual_baseline_minutes": 12
    },
    {
      "id": "workflow_z_ops_mcp_codemode_triage",
      "upstream_name": "ops_mcp",
      "upstream_kind": "fake_mcp_server_obo",
      "mode": "codemode_upfront",
      "expected_status": "completed_unverified",
      "expected_candidate_present": true,
      "manual_baseline_minutes": 10
    },
    {
      "id": "negative_hr_browse_only_not_credited",
      "upstream_name": "hr_directory",
      "upstream_kind": "fake_openapi_api",
      "mode": "traditional",
      "expected_status": "read_only",
      "expected_completed": false
    },
    {
      "id": "negative_hr_partial_missing_requested_verification",
      "upstream_name": "hr_directory",
      "upstream_kind": "fake_openapi_api",
      "mode": "traditional",
      "expected_status": "partial_or_incomplete",
      "expected_completed": false
    },
    {
      "id": "negative_support_mcp_abandoned_error",
      "upstream_name": "support_mcp",
      "upstream_kind": "fake_mcp_server",
      "mode": "traditional",
      "expected_status": "abandoned",
      "expected_completed": false
    }
  ],
  "agent_onboarding_golden_flows": [
    {
      "id": "golden_global_ticketing_agent_onboarding_e2e",
      "upstream_name": "global_ticketing",
      "bundle_fixture": "ticketing_onboarding_bundle.json",
      "expected_tool_count": 18,
      "expected_workflows": [
        "triage_and_resolve_ticket",
        "ticket_escalation_and_sla_review",
        "intake_and_route_new_ticket"
      ],
      "expected_mcp_ui_uris": [
        "ui://mcpcodeaway/global_ticketing/ticket_inspector/r1",
        "ui://mcpcodeaway/global_ticketing/metrics_dashboard/r1"
      ],
      "expected_audience": "api://ticketing-system"
    }
  ]
}
